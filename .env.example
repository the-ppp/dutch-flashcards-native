# Firebase web SDK config — Firebase console > Project settings > General > "Your apps" > SDK setup.
# Copy this file to .env and fill in the real values. .env is gitignored; never commit it.
# For EAS builds, set the same names as EAS environment variables (eas env:create).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: absolute path to GoogleService-Info.plist, consumed by app.config.js.
# Leave unset to use the ./GoogleService-Info.plist checked out locally (also gitignored).
GOOGLE_SERVICES_INFO_PLIST=
